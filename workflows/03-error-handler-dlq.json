    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"username\": \"Aura System Sentry (DLQ)\",\n  \"avatar_url\": \"https://img.icons8.com/fluency/96/error.png\",\n  \"embeds\": [\n    {\n      \"title\": \"🚨 SYSTEM FAILURE DETECTED — DEAD-LETTER QUEUED\",\n      \"color\": 15158332,\n      \"description\": \"An unhandled error terminated an execution in the **{{ $('Format Error Snapshot').item.json.workflow_name }}** platform.\",\n      \"fields\": [\n        {\n          \"name\": \"Error Tracking ID\",\n          \"value\": \"`{{ $('Format Error Snapshot').item.json.error_id }}`\",\n          \"inline\": true\n        },\n        {\n          \"name\": \"Failed Node\",\n          \"value\": \"`{{ $('Format Error Snapshot').item.json.failed_node }}`\",\n          \"inline\": true\n        },\n        {\n          \"name\": \"Airtable DLQ Record\",\n          \"value\": \"`{{ $json.id }}`\",\n          \"inline\": true\n        },\n        {\n          \"name\": \"Error Details\",\n          \"value\": \"```\\n{{ $('Format Error Snapshot').item.json.error_message.slice(0, 500) }}\\n```\"\n        },\n        {\n          \"name\": \"Immediate Action\",\n          \"value\": \"👉 [Inspect Failed Execution in n8n]({{ $('Format Error Snapshot').item.json.execution_url }})\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
