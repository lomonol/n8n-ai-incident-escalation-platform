        "method": "POST",
        "url": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"🚨 *CRITICAL EXECUTION FAILURE:* {{ $('Format Error Snapshot').item.json.error_id }} in {{ $('Format Error Snapshot').item.json.workflow_name }}\",\n  \"blocks\": [\n    {\n      \"type\": \"header\",\n      \"text\": {\n        \"type\": \"plain_text\",\n        \"text\": \"🚨 Execution Failure Queued to DLQ\"\n      }\n    },\n    {\n      \"type\": \"section\",\n      \"fields\": [\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Error ID:*\\\\n`{{ $('Format Error Snapshot').item.json.error_id }}`\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Failed Node:*\\\\n`{{ $('Format Error Snapshot').item.json.failed_node }}`\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Workflow:*\\\\n{{ $('Format Error Snapshot').item.json.workflow_name }}\"\n        },\n        {\n          \"type\": \"mrkdwn\",\n          \"text\": \"*Status:*\\\\n⚠️ *Unresolved (Logged in CRM)*\"\n        }\n      ]\n    },\n    {\n      \"type\": \"section\",\n      \"text\": {\n        \"type\": \"mrkdwn\",\n        \"text\": \"*Error Message:*\\\\n```{{ $('Format Error Snapshot').item.json.error_message.slice(0, 300) }}```\"\n      }\n    },\n    {\n      \"type\": \"actions\",\n      \"elements\": [\n        {\n          \"type\": \"button\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"🔍 Debug Execution in n8n\"\n          },\n          \"style\": \"danger\",\n          \"url\": \"{{ $('Format Error Snapshot').item.json.execution_url }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
